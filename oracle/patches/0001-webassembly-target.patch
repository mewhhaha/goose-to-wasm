--- a/src/codegen.h
+++ b/src/codegen.h
@@ -1033,7 +1033,32 @@ struct CodeGen {
     // top, bumping it. All branches of value-producing control constructs
     // construct to the same destination; calls pass the stack down.
 
-    void Bump(const string &stk, const string &n) { L(TopW(stk), " += ", n, ";"); }
+    // A bounded target has no inaccessible guard pages. Reserve before a
+    // write, and before a bump that only leaves room to be filled later.
+    // The explicit top may be a cached local rather than stk->top.
+    void Reserve(const string &stk, const string &n) {
+        L("gs_stack_require(", stk, ", ", Top(stk), ", (uint64_t)(", n, "));");
+    }
+    void RequireWrite(const string &at, const string &n) {
+        L("gs_write_require((const uint8_t *)(", at, "), (uint64_t)(", n, "));");
+    }
+    template<class Size> string StackBytes(const string &n, const Size &esz) {
+        return cat("gs_stack_bytes((uint64_t)(", n, "), ", esz, ")");
+    }
+    void Bump(const string &stk, const string &n) {
+        // n can be a write (gs_uleb_write/gs_zig_write), which checks its
+        // own destination. Evaluate it once before checking the bump.
+        if (n.find("gs_uleb_write(") != string::npos ||
+            n.find("gs_zig_write(") != string::npos) {
+            auto count = T();
+            L("int64_t ", count, " = ", n, ";");
+            Reserve(stk, count);
+            L(TopW(stk), " += ", count, ";");
+        } else {
+            Reserve(stk, n);
+            L(TopW(stk), " += ", n, ";");
+        }
+    }
 
     void EmitValStore(const string &stk, TypeExpr *t, const string &x);
     void StoreWhole(const string &p, TypeExpr *t, const string &x);
