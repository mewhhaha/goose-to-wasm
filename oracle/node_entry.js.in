// Kept outside Emscripten's factory so importing a program never runs its main.
// Emscripten embeds this file with --extern-post-js.
if (
  typeof process !== "undefined" &&
  process.versions &&
  process.versions.node &&
  process.argv[1]
) {
  const { pathToFileURL } = await import("node:url");
  const { realpathSync } = await import("node:fs");
  let isMain = false;
  try {
    isMain = import.meta.url === pathToFileURL(realpathSync(process.argv[1])).href;
  } catch {
    // stdin and embedding hosts need not give argv[1] a real file name.
  }
  if (isMain) {
    await createGooseModule({ arguments: process.argv.slice(2) });
  }
}
