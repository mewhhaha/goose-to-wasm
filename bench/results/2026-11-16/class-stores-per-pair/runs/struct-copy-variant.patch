+// The one type that every reference or slice a value of type `ty` holds
+// inline points at, or -1 where it holds none or they point at several.
+// What the storage those point at holds in turn is not the value's.
+fn life_single_pointee(p: Program&, l: Lifetimes&, ty: i64) -> i64 {
+    if ty < 0 { return -1; }
+    while l.single_pointee.len < p.types.len { l.single_pointee.push(-2); }
+    if l.single_pointee[ty] != -2 { return l.single_pointee[ty]; }
+    var work: i64[>..] = [ty]; var at = 0; var only = -1; var several = false;
+    while at < work.len && !several {
+        let t: const Type& = p.types[work[at]]; at += 1;
+        if t.kind == TY_SLICE || t.kind == TY_REF {
+            if t.kind == TY_REF && t.length_storage >= 0 { several = true; }
+            else if only < 0 { only = t.element; }
+            else if t.element < 0 || !life_same(p, only, t.element) { several = true; }
+        } else if t.kind == TY_ARRAY && t.element >= 0 {
+            var seen = false; for old in work { if old == t.element { seen = true; } }
+            if !seen { work.push(t.element); }
+        } else if t.kind == TY_STRUCT || t.kind == TY_ENUM || t.kind == TY_TUPLE {
+            var field = t.first;
+            while field >= 0 {
+                let ft = p.nodes[field].type_id; var seen = ft < 0;
+                for old in work { if old == ft { seen = true; } }
+                if !seen { work.push(ft); }
+                field = p.nodes[field].next;
+            }
+        }
+    }
+    if several || only < 0 { only = -1; }
+    l.single_pointee[ty] = only;
+    return only;
+}
+// What a value whose references all point at `only` can hold of a set: a
+// struct copied out of storage carries everything its root holds, of which
+// a table of slices of one element type holds only what such a slice can be.
+// What a class's storage holds, with no type yet, becomes a reference to
+// that type (a call then maps it by it, life_map_onto); a root, an argument
+// class or a reference of another type that cannot hold one is dropped.
+fn life_holder_narrow(p: Program&, l: Lifetimes&, set: i64, only: i64) -> i64 {
+    if set == 0 { return set; }
+    if l.narrowed.len == 0 { l.narrowed.resize(4096, LifeLoaded {}); }
+    var h: u64 = (set as! u64) * 11400714819323198485 ^ (only as! u64) * 14029467366897019727; h ^= h >> 29;
+    let memo = (h & ((l.narrowed.len - 1) as! u64)) as i64;
+    if l.narrowed[memo].contents == set && l.narrowed[memo].places == only { return l.narrowed[memo].set; }
+    var out = LifeBuild {}; var at = l.sets[set].first; var changed = false;
+    while at >= 0 {
+        var x = l.alts[at]; at = x.next; x.next = -1;
+        if x.exact && !x.byteview && x.root != 0 {
+            let owner = l.roots[x.root].class_frame; var within = x.target_type as i64;
+            if owner >= 0 && l.roots[x.root].class_parent >= 0 { within = l.roots[x.root].class_type; }
+            else if owner >= 0 && l.roots[x.root].class_index >= l.frames[owner].class_base {
+                if within < 0 { x.target_type = only as i32; changed = true; life_build_add_alt(l, out, x); continue; }
+            } else if within < 0 && owner >= 0 { within = l.roots[x.root].class_pointee; }
+            else if within < 0 { within = l.roots[x.root].type_id; }
+            if within >= 0 && !life_contains(p, l, within, only) { changed = true; continue; }
+        }
+        life_build_add_alt(l, out, x);
+    }
+    var result = life_build_end(l, out);
+    if !changed { result = set; }
+    l.narrowed[memo] = LifeLoaded { contents: set, places: only, set: result };
+    return result;
+}
