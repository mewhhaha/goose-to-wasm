+// A partially replayed summary may already have offered eight consecutive
+// reads in this chain. Appends never splice entries between existing reads.
+// Follow the last read's current successor, including later appends.
+fn life_replay_group(p: Program&, l: Lifetimes&, frame: i64, chain: i64, first: i64, at: i64, complete: bool&) -> i64 {
+    if l.read_groups.len == 0 { l.read_groups.resize(4096, LifeReadGroup {}); }
+    let slot = first & 4095; let group = l.read_groups[slot];
+    let version = l.frames[frame].reads_version;
+    if group.first as i64 == first && group.chain == chain && group.version == version {
+        let last = group.last as i64;
+        if at < 0 || (l.summary_reads[last].before as i64) < at { return l.summary_reads[last].next as i64; }
+    }
+    var read = first; var count: i64 = 0; var last = first; var offered = true;
+    while count < 8 && read >= 0 && (at < 0 || (l.summary_reads[read].before as i64) < at) {
+        last = read; let leaf = l.summary_reads[read].leaf as i64; read = l.summary_reads[read].next as i64;
+        count++;
+        if life_leaf_offered(l, leaf) { continue; }
+        l.offer_count = 0; l.offer_recursive = false;
+        life_construct_read(p, l, l.leaves[leaf].node, l.leaves[leaf].value, leaf);
+        if !life_leaf_offered(l, leaf) { offered = false; complete = false; }
+    }
+    if count == 8 && offered && l.frames[frame].reads_version == version {
+        l.read_groups[slot] = LifeReadGroup { first: first as i32, last: last as i32, chain: chain, version: version };
+    }
+    return read;
+}
