+// Find the exact (first read, destination chain and recursion epoch) pair.
+fn life_group_slot(l: Lifetimes&, first: i64, chain: i64) -> i64 {
+    let mask = l.read_groups.len - 1; var slot = life_mix(first, chain) & mask;
+    while l.read_groups[slot].first >= 0 {
+        if l.read_groups[slot].first as i64 == first && l.read_groups[slot].chain == chain { break; }
+        slot = (slot + 1) & mask;
+    }
+    return slot;
+}
+fn life_group_grow(l: Lifetimes&) {
+    var held: LifeReadGroup[>..] = []; held.append(l.read_groups);
+    l.read_groups.clear(); var size = 256;
+    if held.len > 0 { size = held.len * 2; }
+    l.read_groups.resize(size, LifeReadGroup {});
+    for group in held {
+        if group.first < 0 { continue; }
+        let slot = life_group_slot(l, group.first as i64, group.chain);
+        l.read_groups[slot] = group;
+    }
+}
