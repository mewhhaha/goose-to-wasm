+// A row records all pointee classes reached through one owner's inline storage.
+fn life_containment_row(p: Program&, l: Lifetimes&, owner: i64) -> i64 {
+    let row = l.containment_bits.len;
+    l.containment_rows[owner] = row;
+    l.containment_bits.resize(row + ((l.type_canon.len + 63) >> 6), 0 as u64);
+    var work: i64[>..] = [owner];
+    l.containment_seen[owner] = owner;
+    var at = 0;
+    while at < work.len {
+        let id = work[at]; at += 1;
+        let canonical = l.type_canon[id];
+        l.containment_bits[row + (canonical >> 6)] |= (1 as u64) << (canonical & 63);
+        let t: const Type& = p.types[id];
+        if t.kind == TY_ARRAY && t.element >= 0 {
+            if l.containment_seen[t.element] != owner {
+                l.containment_seen[t.element] = owner; work.push(t.element);
+            }
+        } else if t.kind == TY_STRUCT || t.kind == TY_ENUM || t.kind == TY_TUPLE {
+            var field = t.first;
+            while field >= 0 {
+                let child = p.nodes[field].type_id;
+                if child >= 0 && l.containment_seen[child] != owner {
+                    l.containment_seen[child] = owner; work.push(child);
+                }
+                field = p.nodes[field].next;
+            }
+        }
+    }
+    return row;
