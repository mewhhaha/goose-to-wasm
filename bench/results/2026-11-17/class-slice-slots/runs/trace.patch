+fn dbg_defer(p: Program&, l: Lifetimes&, kind: i64, node: i64, source: LifeAlt, dst: LifeAlt, callee: i64, places: i64, contents: i64) {
+    if !l.discovery { return; }
+    for old in dbg_defer_nodes { if old == node * 4 + kind { return; } }
+    dbg_defer_nodes.push(node * 4 + kind);
+    var o: u8[>..] = []; if kind == 0 { o.append("DBGDEFER body at="); } else if kind == 2 { o.append("DBGDEFER perm at="); } else if kind == 3 { o.append("DBGDEFER argarg at="); } else { o.append("DBGDEFER map at="); } dbg_at(p, o, node);
