+    o.append(" src="); dbg_root(p, l, o, source); o.append(" dst="); dbg_root(p, l, o, dst);
+    if places >= 0 { dbg_alts(p, l, o, "calleeplaces", places); dbg_alts(p, l, o, "calleevalue", contents); }
+    o.push(10 as u8); write_stderr(o);
+}
