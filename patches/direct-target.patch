+            if (cache) cache->Scanned(nullptr);
+            ScanNext(); return;
+        }
+        auto position = size_t(p - source), start = size_t(linestart - source);
+        auto before_line = line, before_curlies = curlies;
+        auto it = cached_file->transitions.find(position);
+        if (it != cached_file->transitions.end()) {
+            auto &t = it->second;
+            if (t.before_line == line && t.before_line_start == start && t.before_curlies == curlies) {
+                prevend = p; prevendline = line; prevendlinestart = linestart;
+                p = source + t.after_position; linestart = source + t.after_line_start;
+                line = t.after_line; curlies = t.after_curlies;
+                tok = TType(t.token); tokline = t.token_line;
+                toklinestart = source + t.token_line_start;
+                attr = string_view(source + t.attribute, t.attribute_size);
+                doc = t.has_documentation ? string_view(source + t.documentation, t.documentation_size) : string_view();
+                scanning = false;
+                if (tok == T_INTLIT) { ival = t.value.integer; iuns = t.unsigned_integer; }
+                else if (tok == T_FLTLIT) fval = t.value.floating;
+                else if (tok == T_STRLIT) { sval = *t.string_value; smultiline = t.multiline; }
+                cache->Hit(*cached_file, t);
+                return;
+            }
+        }
+        cache->Scanned(cached_file.get());
+        ScanNext();  // A failed scan is never stored: preserve recovery timing.
+        LexicalTransition t;
+        t.before_line = before_line; t.before_line_start = start; t.before_curlies = before_curlies;
+        t.after_position = size_t(p - source); t.after_line_start = size_t(linestart - source);
+        t.after_line = line; t.after_curlies = curlies;
+        t.token = int(tok); t.token_line = tokline; t.token_line_start = size_t(toklinestart - source);
+        t.attribute = size_t(attr.data() - source); t.attribute_size = attr.size();
+        t.has_documentation = doc.data() != nullptr;
+        if (t.has_documentation) { t.documentation = size_t(doc.data() - source); t.documentation_size = doc.size(); }
+        if (tok == T_INTLIT) { t.value.integer = ival; t.unsigned_integer = iuns; }
+        else if (tok == T_FLTLIT) t.value.floating = fval;
+        else if (tok == T_STRLIT) { t.string_value = make_unique<string>(sval); t.multiline = smultiline; }
+        cache->Store(*cached_file, position, std::move(t));
