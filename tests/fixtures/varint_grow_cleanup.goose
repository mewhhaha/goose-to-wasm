var neighbor:varint[>..]=[64,-65];recursive fn use(n:i64)->i64{for i in 0..8{var a:varint[>..]=[n];a.append([-65;64]);let kept:const varint& =a.push(8192);if i%2==0{continue;}if kept!=8192{abort("bad");}}var b:varint[>..]=[64];b.clear();b.append([n]);b=[n+1];for value in b{return value;}abort("empty");}export fn tick(n:i64)->i64{return use(n);}fn main(){var sum=0;for i in 0..1000{sum+=tick(i);}print(sum," ",neighbor);}
