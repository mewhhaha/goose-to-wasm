recursive fn make(n:i64)->varint[>..]{var a:varint[>..]=[n];a.push(64);return a;}inline fn imake(n:i64)->varint[>..]{var a:varint[>..]=[n];a.push(-65);return a;}recursive fn own(a:varint[>..])->varint[>..]{a.push(8192);return a;}fn invoke<F>()->varint[>..]{return F();}recursive fn variable(n:i64)->varint[u8]{var a:varint[>..]=[n];a.push(64);return a;}fn main(){let a=make(1);let b=own(copy(a));print(a," ",b," ",imake(2));let c:varint[u16]=make(3);let d:varint[>..]=variable(4);print(c," ",d);print(invoke(){var a:varint[>..]=[5];a.push(-65);copy(a)});}
