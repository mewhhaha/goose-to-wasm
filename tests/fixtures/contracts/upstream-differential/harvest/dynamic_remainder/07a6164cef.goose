recursive fn narrow(a:i32,b:i32)->i32 { a%b }
recursive fn unsigned32(a:u32,b:u32)->u32 { a%b }
recursive fn unsigned64(a:u64,b:u64)->u64 { a%b }
recursive fn literal(a:i64) { print(a%8," ",a%-8," ",a%3); }
fn main() {print(narrow((0x80000000 as! i32),(0x80000000 as! i32)));print(narrow((0x80000000 as! i32),(0xfffffff8 as! i32)));print(narrow((0x80000000 as! i32),(0xffffffff as! i32)));print(narrow((0x80000000 as! i32),(0x1 as! i32)));print(narrow((0x80000000 as! i32),(0x8 as! i32)));print(narrow((0x80000000 as! i32),(0xb as! i32)));print(narrow((0xffffffef as! i32),(0x80000000 as! i32)));print(narrow((0xffffffef as! i32),(0xfffffff8 as! i32)));print(narrow((0xffffffef as! i32),(0xffffffff as! i32)));print(narrow((0xffffffef as! i32),(0x1 as! i32)));print(narrow((0xffffffef as! i32),(0x8 as! i32)));print(narrow((0xffffffef as! i32),(0xb as! i32)));print(narrow((0x0 as! i32),(0x80000000 as! i32)));print(narrow((0x0 as! i32),(0xfffffff8 as! i32)));print(narrow((0x0 as! i32),(0xffffffff as! i32)));print(narrow((0x0 as! i32),(0x1 as! i32)));print(narrow((0x0 as! i32),(0x8 as! i32)));print(narrow((0x0 as! i32),(0xb as! i32)));print(narrow((0x11 as! i32),(0x80000000 as! i32)));print(narrow((0x11 as! i32),(0xfffffff8 as! i32)));print(narrow((0x11 as! i32),(0xffffffff as! i32)));print(narrow((0x11 as! i32),(0x1 as! i32)));print(narrow((0x11 as! i32),(0x8 as! i32)));print(narrow((0x11 as! i32),(0xb as! i32)));print(narrow((0x7fffffff as! i32),(0x80000000 as! i32)));print(narrow((0x7fffffff as! i32),(0xfffffff8 as! i32)));print(narrow((0x7fffffff as! i32),(0xffffffff as! i32)));print(narrow((0x7fffffff as! i32),(0x1 as! i32)));print(narrow((0x7fffffff as! i32),(0x8 as! i32)));print(narrow((0x7fffffff as! i32),(0xb as! i32)));print(unsigned32(0x0,0x1));print(unsigned32(0xffffffff,0x1));print(unsigned32(0xffffffff,0x8));print(unsigned32(0xffffffff,0xffffffff));print(unsigned32(0x80000000,0x7fffffff));print(unsigned32(0xffffffff,0x80000000));print(unsigned64(0x0,0x1));print(unsigned64(0xffffffffffffffff,0x1));print(unsigned64(0xffffffffffffffff,0x8));print(unsigned64(0xffffffffffffffff,0xffffffffffffffff));print(unsigned64(0x8000000000000000,0x7fffffffffffffff));print(unsigned64(0xffffffffffffffff,0x8000000000000000));literal((0x8000000000000000 as! i64));literal((0xffffffffffffffef as! i64));literal((0xffffffffffffffff as! i64));literal((0x0 as! i64));literal((0x1 as! i64));literal((0x11 as! i64));literal((0x7fffffffffffffff as! i64));}